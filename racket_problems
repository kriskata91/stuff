#lang racket

(define head car)
(define tail cdr)

(define (length* lst)
  (if (null? lst)
      0
      (length* (tail lst))))

(define (map* f lst)
  (if (null? lst)
      '()
      (cons (f (head lst)) (map* f (tail lst)))))

;length, reverse, map, filter, foldr.

(define (take n lst)
  (if (or (null? lst) (zero? n))
      '()
      (cons (head lst) (take (- n 1) (tail lst))))) 

(define (drop n lst)
  (if (or (null? lst) (zero? n))
      lst
      (drop (- n 1) (cdr lst))))

;------------------------------------------------------
(define (foldr op nv l)
  (if (null? l)
      nv
      (op (head l) (foldr op nv (tail l)))))

(define (foldl op nv l)
  (if (null? l)
      nv
      (foldr op (op nv (head l)) (tail l))))


(define (all? p? lst)
  (or (null? lst) (and (p? (head lst)) (all? p? (tail lst)))))

(define (any? p? lst)
  (or (not (null? lst))
      (or (p? (head lst))
          (any? p? (tail lst)))))

(define (zip lst1 lst2)
  (if (or (null? lst1) (null? lst2))
      '()
      (cons (cons (head lst1) (head lst2)) (zip (tail lst1) (tail lst2)))))

(define (zip-with-zipWith lst1 lst2) ;;;;;;;;;;;
  (zipWith cons lst1 lst2))

(define (zipWith f lst1 lst2)
  (if (or (null? lst1) (null? lst2))
      '()
      (cons (f (head lst1) (head lst2)) (zipWith f (tail lst1) (tail lst2)))))

(define (sorted? lst)
  (or (or (null? lst) (null? (tail lst))) (and (<= (head lst) (head (tail lst))) (sorted? (tail lst)))))

